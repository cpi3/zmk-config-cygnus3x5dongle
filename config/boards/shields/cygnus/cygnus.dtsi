#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>
/ {
    chosen {
        zephyr,display = &oled;
        zmk,kscan = &kscan0;
        zmk,physical-layout = &my_custom_layout;
    };
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
        map = <
        RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)     RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
        RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)     RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
        RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)     RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
                        RC(3,2) RC(3,3) RC(3,4)     RC(3,5) RC(3,6) RC(3,7)
        >;
    };
    my_custom_layout: my_custom_layout {
        compatible = "zmk,physical-layout";
        display-name = "Cygnus 3x5";
        transform = <&default_transform>;
        keys =
            // Row 0 Left
            <&key_physical_attrs 100 100    0  137        0     0     0>, <&key_physical_attrs 100 100  100  112        0     0     0>, <&key_physical_attrs 100 100  200  100        0     0     0>, <&key_physical_attrs 100 100  300  112        0     0     0>, <&key_physical_attrs 100 100  400  125        0     0     0>,
            // Row 0 Right
            <&key_physical_attrs 100 100  950  125        0     0     0>, <&key_physical_attrs 100 100 1050  112        0     0     0>, <&key_physical_attrs 100 100 1150  100        0     0     0>, <&key_physical_attrs 100 100 1250  112        0     0     0>, <&key_physical_attrs 100 100 1350  137        0     0     0>,
            // Row 1 Left
            <&key_physical_attrs 100 100    0  237        0     0     0>, <&key_physical_attrs 100 100  100  212        0     0     0>, <&key_physical_attrs 100 100  200  200        0     0     0>, <&key_physical_attrs 100 100  300  212        0     0     0>, <&key_physical_attrs 100 100  400  225        0     0     0>,
            // Row 1 Right
            <&key_physical_attrs 100 100  950  225        0     0     0>, <&key_physical_attrs 100 100 1050  212        0     0     0>, <&key_physical_attrs 100 100 1150  200        0     0     0>, <&key_physical_attrs 100 100 1250  212        0     0     0>, <&key_physical_attrs 100 100 1350  237        0     0     0>,
            // Row 2 Left
            <&key_physical_attrs 100 100    0  337        0     0     0>, <&key_physical_attrs 100 100  100  312        0     0     0>, <&key_physical_attrs 100 100  200  300        0     0     0>, <&key_physical_attrs 100 100  300  312        0     0     0>, <&key_physical_attrs 100 100  400  325        0     0     0>,
            // Row 2 Right
            <&key_physical_attrs 100 100  950  325        0     0     0>, <&key_physical_attrs 100 100 1050  312        0     0     0>, <&key_physical_attrs 100 100 1150  300        0     0     0>, <&key_physical_attrs 100 100 1250  312        0     0     0>, <&key_physical_attrs 100 100 1350  337        0     0     0>,
            // Thumbs Left (outer -> inner)
            <&key_physical_attrs 100 100  250  415        0     0     0>, <&key_physical_attrs 100 100  350  425        0     0     0>, <&key_physical_attrs 100 150  475  400     3000   525   475>,
            // Thumbs Right (inner -> outer)
            <&key_physical_attrs 100 150  875  400  (-3000)   925   475>, <&key_physical_attrs 100 100 1000  425        0     0     0>, <&key_physical_attrs 100 100 1100  415        0     0     0>;
    };
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";
        row-gpios
            = <&pro_micro 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 18 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };
};
&pro_micro_i2c {
    status = "okay";
    oled: ssd1306@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        width = <128>;
        height = <32>;
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <31>;
        segment-remap;
        com-invdir;
        com-sequential;
        inversion-on;
        prechargep = <0x22>;
    };
};